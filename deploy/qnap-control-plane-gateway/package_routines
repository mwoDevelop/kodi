# Expose the package-owned CGI directory through QTS' stable QPKG CGI namespace.
pkg_post_install() {
    cgi_root="/home/httpd/cgi-bin/qpkg"
    cgi_link="$cgi_root/$QPKG_NAME"
    cgi_target="$SYS_QPKG_DIR/www"

    $CMD_CHOWN 0:0 "$SYS_QPKG_DIR/www/gateway.cgi"
    $CMD_CHOWN 0:0 "$SYS_QPKG_DIR/KodiCPGateway.sh"
    $CMD_CHMOD 0755 "$SYS_QPKG_DIR/www/gateway.cgi"
    $CMD_CHMOD 0755 "$SYS_QPKG_DIR/KodiCPGateway.sh"
    $CMD_CHOWN 0:0 "$SYS_QPKG_DIR/private"
    $CMD_CHMOD 0700 "$SYS_QPKG_DIR/private"
    for private_file in operator-username operator-credential totp-secret; do
        if [ -f "$SYS_QPKG_DIR/private/$private_file" ] && [ ! -L "$SYS_QPKG_DIR/private/$private_file" ]; then
            $CMD_CHOWN 0:0 "$SYS_QPKG_DIR/private/$private_file"
            $CMD_CHMOD 0600 "$SYS_QPKG_DIR/private/$private_file"
        fi
    done

    $CMD_MKDIR -p "$cgi_root"
    if [ -L "$cgi_link" ]; then
        existing_target=`readlink "$cgi_link"`
        if [ "$existing_target" != "$cgi_target" ]; then
            err_log "Refusing to replace foreign CGI symlink: $cgi_link"
            return 1
        fi
    elif [ -e "$cgi_link" ]; then
        err_log "Refusing to replace non-symlink CGI path: $cgi_link"
        return 1
    fi
    $CMD_RM -f "$cgi_link"
    $CMD_LN -s "$cgi_target" "$cgi_link"


    # An upgrade from 0.1.x must not leave the volatile Apache proxy metadata.
    $CMD_SETCFG "$QPKG_NAME" Use_Proxy "0" -f "$SYS_QPKG_CONFIG_FILE"
    $CMD_SETCFG "$QPKG_NAME" Proxy_Path "" -f "$SYS_QPKG_CONFIG_FILE"
    $CMD_SETCFG "$QPKG_NAME" Service_Program "KodiCPGateway.sh" -f "$SYS_QPKG_CONFIG_FILE"
}

PKG_PRE_REMOVE="{
    cgi_link=\"/home/httpd/cgi-bin/qpkg/$QPKG_NAME\"
    if [ -L \"\$cgi_link\" ]; then
        link_target=\`readlink \"\$cgi_link\"\`
        case \"\$link_target\" in
            \"$SYS_QPKG_DIR\"/www) $CMD_RM -f \"\$cgi_link\" ;;
        esac
    fi
}"
