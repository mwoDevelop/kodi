UPSTREAM_WATCHDOG_IMAGE=ghcr.io/mwodevelop/kodi-upstream-watchdog@sha256:replace-with-release-digest
UPSTREAM_WATCHDOG_GITHUB_TOKEN=replace-with-actions-write-checks-read-api-token
UPSTREAM_WATCHDOG_STATE_DIR=/share/CACHEDEV3_DATA/.mwodevelop-services/upstream-watchdog-v1/state
UPSTREAM_WATCHDOG_TLS_CERT=/share/CACHEDEV3_DATA/.mwodevelop-services/upstream-watchdog-v1/config/server.crt
UPSTREAM_WATCHDOG_TLS_KEY=/share/CACHEDEV3_DATA/.mwodevelop-services/upstream-watchdog-v1/config/server.key
UPSTREAM_WATCHDOG_CLIENT_CA=/share/CACHEDEV3_DATA/.mwodevelop-services/upstream-watchdog-v1/config/clients-ca.crt
