{
  "schema": 1,
  "timezone": "UTC",
  "jobs": [
    {
      "id": "github-kodi-publish-pages",
      "kind": "github_actions",
      "owner": "release",
      "repository": "mwoDevelop/kodi",
      "workflow": "publish-pages.yml",
      "event": "schedule",
      "cron": ["10 3 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 3600,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-kodi-approve-umbrella-update",
      "kind": "github_actions",
      "owner": "supply-chain",
      "repository": "mwoDevelop/kodi",
      "workflow": "approve-umbrella-update.yml",
      "event": "schedule",
      "cron": ["*/15 * * * *"],
      "grace_seconds": 900,
      "timeout_seconds": 1800,
      "stale_after_seconds": 3600,
      "retry_policy": "next_schedule",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-kodi-approve-umbrella-promotion",
      "kind": "github_actions",
      "owner": "release",
      "repository": "mwoDevelop/kodi",
      "workflow": "approve-umbrella-promotion.yml",
      "event": "schedule",
      "cron": ["7,37 * * * *"],
      "grace_seconds": 1200,
      "timeout_seconds": 1800,
      "stale_after_seconds": 7200,
      "retry_policy": "next_schedule",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-kodi-reconcile-upstreams",
      "kind": "github_actions",
      "owner": "supply-chain",
      "repository": "mwoDevelop/kodi",
      "workflow": "reconcile-upstreams.yml",
      "event": "schedule",
      "cron": ["20 4 * * *", "35 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 7200,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-kodi-check-youtube-upstream",
      "kind": "github_actions",
      "owner": "supply-chain",
      "repository": "mwoDevelop/kodi",
      "workflow": "check-youtube-upstream.yml",
      "event": "schedule",
      "cron": ["29 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 7200,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-mwoscrapers-check-provider-upstreams",
      "kind": "github_actions",
      "owner": "providers",
      "repository": "mwoDevelop/script.module.mwoscrapers",
      "workflow": "check-provider-upstreams.yml",
      "event": "schedule",
      "cron": ["23 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 7200,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-mwoscrapers-discover-provider-upstreams",
      "kind": "github_actions",
      "owner": "providers",
      "repository": "mwoDevelop/script.module.mwoscrapers",
      "workflow": "discover-provider-upstreams.yml",
      "event": "schedule",
      "cron": ["41 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 3600,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-mwoscrapers-probe-provider-health",
      "kind": "github_actions",
      "owner": "providers",
      "repository": "mwoDevelop/script.module.mwoscrapers",
      "workflow": "probe-provider-health.yml",
      "event": "schedule",
      "cron": ["3 5 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 3600,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-umbrella-propose-upstream-update",
      "kind": "github_actions",
      "owner": "umbrella",
      "repository": "mwoDevelop/umbrellaplug.github.io",
      "workflow": "propose-upstream-update.yml",
      "event": "schedule",
      "cron": ["50 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 7200,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-umbrella-approve-upstream-update",
      "kind": "github_actions",
      "owner": "umbrella",
      "repository": "mwoDevelop/umbrellaplug.github.io",
      "workflow": "approve-upstream-update.yml",
      "event": "schedule",
      "cron": ["2,17,32,47 * * * *"],
      "grace_seconds": 900,
      "timeout_seconds": 1800,
      "stale_after_seconds": 3600,
      "retry_policy": "next_schedule",
      "dependencies": ["github-actions"]
    },
    {
      "id": "github-watchnixtoons2-update",
      "kind": "github_actions",
      "owner": "watchnixtoons2",
      "repository": "mwoDevelop/ch.repo",
      "workflow": "mwodevelop-watchnixtoons2-update.yml",
      "event": "schedule",
      "cron": ["35 4 * * *"],
      "grace_seconds": 1800,
      "timeout_seconds": 7200,
      "stale_after_seconds": 129600,
      "retry_policy": "manual",
      "dependencies": ["github-actions"]
    },
    {
      "id": "qnap-upstream-watchdog",
      "kind": "internal_interval",
      "owner": "operations",
      "interval_seconds": 21600,
      "grace_seconds": 900,
      "timeout_seconds": 120,
      "stale_after_seconds": 28800,
      "retry_policy": "next_interval",
      "dependencies": ["github-api"],
      "observer": "not_implemented"
    },
    {
      "id": "kodi-profile-sync-device",
      "kind": "device_interval",
      "owner": "profiles",
      "interval_seconds": 21600,
      "grace_seconds": 1800,
      "timeout_seconds": 900,
      "stale_after_seconds": 28800,
      "retry_policy": "next_interval",
      "dependencies": ["profile-sync"],
      "observer": "profile_sync_heartbeat"
    }
  ]
}
