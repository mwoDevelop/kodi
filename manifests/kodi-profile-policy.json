{
  "schema": 2,
  "name": "portable-android-kodi-profile",
  "scopes": {
    "disaster_recovery": {
      "include": [
        "addons/**",
        "userdata/*.xml",
        "userdata/*.json",
        "userdata/*.xsp",
        "userdata/addon_data/**",
        "userdata/favourite-artwork/**",
        "userdata/keymaps/**",
        "userdata/library/**",
        "userdata/playlists/**",
        "userdata/profiles/**",
        "userdata/Savestates/**"
      ],
      "exclude": [
        "addons/packages/**",
        "addons/temp/**",
        "userdata/Database/**",
        "userdata/Thumbnails/**",
        "userdata/peripheral_data/**",
        "userdata/temp/**",
        "userdata/addon_data/**/cache/**",
        "userdata/addon_data/**/temp/**",
        "userdata/addon_data/service.mwodevelop.profilesync/**",
        "userdata/addon_data/plugin.video.umbrella/artwork.db",
        "userdata/addon_data/plugin.video.umbrella/cache.db",
        "userdata/addon_data/plugin.video.umbrella/cache.v",
        "userdata/addon_data/plugin.video.umbrella/fanarttv.db",
        "userdata/addon_data/plugin.video.umbrella/metadata.db",
        "userdata/addon_data/plugin.video.umbrella/providers.db",
        "userdata/addon_data/plugin.video.umbrella/search.db",
        "userdata/addon_data/plugin.video.umbrella/traktSync.db",
        "userdata/addon_data/plugin.video.umbrella/*_qr.png",
        "**/*.log",
        "**/*.log.old",
        "**/*.tmp"
      ],
      "notes": [
        "Add-on code is retained so restore is independent of repository availability.",
        "Addons, texture, EPG, thumbnail and peripheral databases are rebuilt.",
        "Umbrella credentials remain in addon_data/plugin.video.umbrella/settings.xml.",
        "Library databases are deferred because they cannot be atomically replaced while Kodi owns them.",
        "WatchNixtoons2 favourite artwork is materialized under userdata/favourite-artwork so it survives cache-free restores.",
        "Profile Sync enrollment, token, private key, journal and local state are never backed up or restored."
      ]
    },
    "routine": {
      "default": "excluded",
      "default_profile_only": true,
      "device_local_paths": [
        "userdata/addon_data/service.mwodevelop.profilesync/**"
      ],
      "adapters": [
        {
          "id": "kodi.core",
          "adapter": "json_rpc",
          "path": "userdata/guisettings.xml",
          "apply_mode": "hot_apply",
          "settings": {
            "general.addonupdates": {
              "type": "integer",
              "class": "portable"
            },
            "lookandfeel.skin": {
              "type": "string",
              "class": "portable"
            }
          }
        },
        {
          "id": "umbrella.preferences",
          "adapter": "settings_xml",
          "addon_id": "plugin.video.umbrella",
          "path": "userdata/addon_data/plugin.video.umbrella/settings.xml",
          "apply_mode": "next_start",
          "compatible_versions": ">=6.7.81,<7",
          "settings": {
            "cache.providers": {
              "type": "integer",
              "class": "portable"
            },
            "external_provider.module": {
              "type": "string",
              "class": "portable"
            },
            "external_provider.name": {
              "type": "string",
              "class": "portable"
            },
            "provider.external.enabled": {
              "type": "boolean",
              "class": "portable"
            },
            "rd_cloud.enabled": {
              "type": "boolean",
              "class": "portable"
            },
            "realdebrid.filter.filename": {
              "type": "boolean",
              "class": "portable"
            },
            "scrapers.timeout": {
              "type": "integer",
              "class": "portable"
            },
            "sources.useonlyone": {
              "type": "boolean",
              "class": "portable"
            }
          }
        }
      ]
    }
  }
}
