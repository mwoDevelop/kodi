{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwodevelop.github.io/kodi/schemas/profile-sync.schema.json",
  "title": "mwoDevelop Kodi routine profile revision",
  "oneOf": [
    {
      "$ref": "#/$defs/revisionV2"
    },
    {
      "$ref": "#/$defs/revisionV3"
    }
  ],
  "$defs": {
    "commonProperties": {
      "type": "object",
      "properties": {
        "revision_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kodi_major": {
          "type": "integer",
          "minimum": 19
        }
      }
    },
    "revisionV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision_id",
        "policy_sha256",
        "kodi_major",
        "adapters"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "revision_id": {
          "$ref": "#/$defs/commonProperties/properties/revision_id"
        },
        "policy_sha256": {
          "$ref": "#/$defs/commonProperties/properties/policy_sha256"
        },
        "kodi_major": {
          "$ref": "#/$defs/commonProperties/properties/kodi_major"
        },
        "adapters": {
          "$ref": "#/$defs/adapters"
        }
      }
    },
    "revisionV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision_id",
        "policy_sha256",
        "kodi_major",
        "base",
        "layers"
      ],
      "properties": {
        "schema": {
          "const": 3
        },
        "revision_id": {
          "$ref": "#/$defs/commonProperties/properties/revision_id"
        },
        "policy_sha256": {
          "$ref": "#/$defs/commonProperties/properties/policy_sha256"
        },
        "kodi_major": {
          "$ref": "#/$defs/commonProperties/properties/kodi_major"
        },
        "base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapters"],
          "properties": {
            "adapters": {
              "$ref": "#/$defs/adapters"
            }
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "selector", "adapters"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "adapters": {
          "$ref": "#/$defs/adapters"
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "all_target_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$"
          }
        },
        "logical_device_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    },
    "adapters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/adapter"
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "apply_mode", "managed_settings", "values"],
      "properties": {
        "adapter": {
          "const": "settings_xml"
        },
        "addon_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "compatible_versions": {
          "type": "string"
        },
        "apply_mode": {
          "enum": ["hot_apply", "next_start", "host_only"]
        },
        "managed_settings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "integer", "string"]
          }
        }
      }
    }
  }
}
