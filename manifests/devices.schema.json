{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwodevelop.github.io/kodi/schemas/devices.schema.json",
  "title": "mwoDevelop private Kodi device inventory",
  "$ref": "#/$defs/registryV2",
  "$defs": {
    "registryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "devices"],
      "properties": {
        "schema": {
          "const": 2
        },
        "devices": {
          "$ref": "#/$defs/devicesV2"
        }
      }
    },
    "devicesV2": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/logicalId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/deviceV2"
      }
    },
    "logicalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["consumer", "publisher"]
      }
    },
    "expectedAndroid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "kodi_major"],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "kodi_major": {
          "type": "integer",
          "minimum": 19
        },
        "abi": {
          "$ref": "#/$defs/abi"
        }
      }
    },
    "expectedFlatpak": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "kodi_major",
        "flatpak_app_id",
        "kodi_data_root"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "kodi_major": {
          "type": "integer",
          "minimum": 19
        },
        "abi": {
          "$ref": "#/$defs/abi"
        },
        "flatpak_app_id": {
          "type": "string",
          "minLength": 1
        },
        "kodi_data_root": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^[/~])|(^|/)\\.\\.(/|$)"
          }
        }
      }
    },
    "abi": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adbEndpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adb"],
      "properties": {
        "adb": {
          "type": "string",
          "minLength": 1
        },
        "jsonrpc": {
          "$ref": "#/$defs/jsonrpc"
        }
      }
    },
    "sshEndpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssh"],
      "properties": {
        "ssh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "user_ref",
            "credential_ref",
            "known_hosts_ref"
          ],
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "user_ref": {
              "type": "string",
              "minLength": 1
            },
            "credential_ref": {
              "type": "string",
              "minLength": 1
            },
            "known_hosts_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "jsonrpc": {
          "$ref": "#/$defs/jsonrpc"
        }
      }
    },
    "jsonrpc": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "deviceV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "physical_host_id",
        "principal_id",
        "platform",
        "roles",
        "expected",
        "endpoints",
        "profile_channel"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "physical_host_id": {
          "$ref": "#/$defs/logicalId"
        },
        "principal_id": {
          "$ref": "#/$defs/logicalId"
        },
        "platform": {
          "enum": ["android", "android-emulator", "linux-flatpak"]
        },
        "roles": {
          "$ref": "#/$defs/roles"
        },
        "expected": {},
        "endpoints": {},
        "profile_channel": {
          "$ref": "#/$defs/logicalId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "enum": ["android", "android-emulator"]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "$ref": "#/$defs/expectedAndroid"
              },
              "endpoints": {
                "$ref": "#/$defs/adbEndpoints"
              }
            }
          },
          "else": {
            "properties": {
              "expected": {
                "$ref": "#/$defs/expectedFlatpak"
              },
              "endpoints": {
                "$ref": "#/$defs/sshEndpoints"
              }
            }
          }
        }
      ]
    }
  }
}
