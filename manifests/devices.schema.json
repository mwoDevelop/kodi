{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mwodevelop.github.io/kodi/schemas/devices.schema.json",
  "title": "mwoDevelop private Kodi device inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "devices"],
  "properties": {
    "schema": {
      "const": 1
    },
    "devices": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/device"
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "roles",
        "expected",
        "endpoints",
        "profile_channel"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["consumer", "publisher"]
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "kodi_major"],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "kodi_major": {
              "type": "integer",
              "minimum": 19
            },
            "abi": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adb"],
          "properties": {
            "adb": {
              "type": "string",
              "minLength": 1
            },
            "jsonrpc": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        },
        "profile_channel": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        }
      }
    }
  }
}
